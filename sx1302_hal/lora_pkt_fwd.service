[Unit]
Description=SX1302 LoRaWAN Packet Forwarder
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
WorkingDirectory=/home/julio/sx1302_hal/packet_forwarder
ExecStartPre=/home/julio/sx1302_hal/reset_lgw.sh start
ExecStart=/home/julio/sx1302_hal/packet_forwarder/lora_pkt_fwd -c /home/julio/sx1302_hal/global_conf.json
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
